# 이 파일을 복사해서 .env 로 이름 바꾸고 값 넣기
#   cp .env.example .env
# .env 는 git에 안 올라가요 (API 키 절대 깃헙에 올리면 안 됨!)

# ChatGPT로 메시지 판단하기 (없으면 단어 목록으로 판단)
OPENAI_API_KEY=
# 쓸 모델 (안 쓰면 gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# 선생님 화면 비밀번호 (1234에서 바꾸면 선생님 주소도 밖에서 열려요)
TEACHER_PIN=1234

# codespace 공개 주소가 막혀 있으면 ngrok으로 (있으면 npm start 할 때 같이 켜짐)
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# ngrok 대시보드 Domains에서 받은 무료 고정 도메인 (없으면 켤 때마다 주소 바뀜)
NGROK_DOMAIN=
